# Web and database (Neon CLI injects the linked DATABASE_URL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
APP_URL="http://localhost:3000"
INTERNAL_API_SECRET="replace-with-a-long-random-secret"

# LiveKit Cloud or self-hosted server
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_AGENT_NAME="ari-interviewer"

# Sarvam credentials stay on the server and in the Python worker only
SARVAM_API_KEY=""
SARVAM_LLM_BASE_URL="https://api.sarvam.ai/v1"
SARVAM_INTERVIEW_MODEL="sarvam-105b-conversations"
SARVAM_REPORT_MODEL="sarvam-105b"
SARVAM_TTS_SPEAKER="priya"
SARVAM_LANGUAGE_CODE="en-IN"
SARVAM_DOCUMENT_LANGUAGE="en-IN"

# Neon Auth (NEON_AUTH_BASE_URL and NEON_AUTH_JWKS_URL are injected by `neon link`)
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Neon Object Storage (injected by `neon link`; keep the candidate bucket private)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://storage.neon.tech"
AWS_REGION=""

# 3D Avatar asset (Julia female avatar bundled in public/avatars/ari.glb)
NEXT_PUBLIC_ARI_AVATAR_GLB="/avatars/ari.glb"
